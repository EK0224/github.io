* {
  box-sizing: border-box;
}

html {
  background: #fdfdfb;
}

body {
  margin: 0;
  color: #181818;
  background: #fdfdfb;
  font-family: Georgia, "Times New Roman", serif;
}


/* HEADER */

.site-header {
  width: min(1240px, calc(100% - 80px));
  margin: 0 auto;

  padding-top: 48px;

  display: flex;
  align-items: baseline;
  justify-content: space-between;

  gap: 40px;
}

.site-title {
  color: inherit;
  text-decoration: none;

  font-size: 1.35rem;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.site-nav {
  display: flex;
  gap: 30px;
}

.site-nav a {
  color: #555;
  text-decoration: none;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.78rem;
  letter-spacing: 0.02em;
}

.site-nav a:hover {
  color: #111;
}


/* HOMEPAGE */

.homepage {
  width: min(1240px, calc(100% - 80px));
  margin: 0 auto;
}

.featured-work {
  width: 76%;
  max-width: 940px;

  margin: 150px auto 220px;
}


/* IMAGE */

.featured-image-link {
  display: block;
}

.featured-image {
  display: block;

  width: 100%;
  height: auto;

  object-fit: cover;
}


/* TEXT BELOW IMAGE */

.featured-info {
  margin-top: 26px;
}

.featured-title {
  display: inline-block;

  color: inherit;
  text-decoration: none;

  font-size: 1.45rem;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.featured-title:hover {
  opacity: 0.62;
}

.featured-meta,
.featured-type {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.76rem;

  color: #777;
}

.featured-meta {
  margin-top: 7px;
}

.featured-type {
  margin-top: 3px;
}


/* MOBILE */

@media (max-width: 700px) {

  .site-header,
  .homepage {
    width: calc(100% - 36px);
  }

  .site-header {
    padding-top: 30px;

    display: block;
  }

  .site-title {
    font-size: 1.15rem;
  }

  .site-nav {
    margin-top: 18px;

    gap: 18px;
    flex-wrap: wrap;
  }

  .featured-work {
    width: 100%;

    margin-top: 90px;
    margin-bottom: 130px;
  }

  .featured-title {
    font-size: 1.25rem;
  }
}  justify-content: center;
  background: #f1f1f1;
  color: #999;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.work h3 {
  margin: 22px 0 4px;
  font-size: 1.35rem;
  font-weight: 400;
}

.work p {
  margin: 0;
  color: #777;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.85rem;
}

@media (max-width: 600px) {
  .site-header,
  main {
    width: min(100% - 30px, 1100px);
  }

  .site-header {
    padding: 46px 0 60px;
  }

  .site-header h1 {
    font-size: 1.8rem;
  }

  nav {
    gap: 18px;
  }

  .work {
    margin-bottom: 64px;
  }
}
