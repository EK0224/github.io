* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #ffffff;
  color: #1d1d1d;
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.6;
}

.site-header,
main {
  width: min(1100px, calc(100% - 48px));
  margin: 0 auto;
}

.site-header {
  padding: 72px 0 80px;
}

.site-header h1 {
  margin: 0 0 28px;
  font-size: 2.3rem;
  font-weight: 400;
  letter-spacing: -0.02em;
}

nav {
  display: flex;
  gap: 30px;
  flex-wrap: wrap;
}

nav a {
  color: #555;
  text-decoration: none;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.9rem;
}

nav a:hover {
  color: #111;
}

.selected-works h2 {
  margin: 0 0 42px;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.work {
  margin-bottom: 90px;
}

.image-placeholder {
  width: 100%;
  aspect-ratio: 16 / 9;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f1f1;
  color: #999;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.work h3 {
  margin: 22px 0 4px;
  font-size: 1.35rem;
  font-weight: 400;
}

.work p {
  margin: 0;
  color: #777;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.85rem;
}

@media (max-width: 600px) {
  .site-header,
  main {
    width: min(100% - 30px, 1100px);
  }

  .site-header {
    padding: 46px 0 60px;
  }

  .site-header h1 {
    font-size: 1.8rem;
  }

  nav {
    gap: 18px;
  }

  .work {
    margin-bottom: 64px;
  }
}
